{
  "name": "Deconstruct Site",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  // Chromium plus the system libraries it needs (--with-deps installs them with apt)
  "postCreateCommand": "pip install -r requirements-browser.txt && python -m playwright install --with-deps chromium",
  // Runs in a terminal each time you open the codespace, so the server log is visible
  "postAttachCommand": { "server": "python app.py" },
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": { "label": "Deconstruct Site", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python"] },
    "codespaces": { "openFiles": ["README.md"] }
  }
}
